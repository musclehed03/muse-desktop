{
  "name": "baxter-deviant-muse",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "description": "Baxter - Our Deviant Muse: an unofficial Dollhouse Deviants desktop client for Muse (muse.ai)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build": "electron-builder",
    "test": "node --test electron/main.test.cjs test/packaging.test.cjs"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.dollhousedeviants.baxter",
    "productName": "Baxter - Our Deviant Muse",
    "artifactName": "Baxter-${version}-${os}-${arch}.${ext}",
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "category": "Utility",
      "icon": "build/icons",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "synopsis": "Desktop client for Baxter, Our Deviant Muse",
      "maintainer": "Dollhouse Deviants",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "identity": null,
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "icon": "build/icon.png"
  },
  "author": "Dollhouse Deviants",
  "homepage": "https://github.com/musclehed03/muse-desktop",
  "desktopName": "baxter-deviant-muse"
}
